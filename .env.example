NODE_ENV=development
PORT=4200
DATABASE_URL=postgresql://dashboard:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55441/sim_dashboard
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
FRONTEND_ORIGIN=http://127.0.0.1:3100
API_INTERNAL_ORIGIN=http://127.0.0.1:4200
SESSION_TTL_SECONDS=28800
LOGIN_WINDOW_SECONDS=900
LOGIN_IP_MAX=30
LOGIN_ACCOUNT_MAX=10
# Docker Compose only; keep in sync with DATABASE_URL.
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=sim_dashboard
# Existing PostgreSQL bin directory for isolated tests (initdb/pg_ctl).
PG_BIN=
# ADMIN-only internal order fixture API; only development/test, never production.
INTERNAL_ORDER_CREATION_ENABLED=false
