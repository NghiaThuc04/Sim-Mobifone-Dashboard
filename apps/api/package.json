{
  "name": "@sim-dashboard/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --watch dist/src/main.js",
    "dev:types": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sim-dashboard/shared": "*",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "prisma": "7.10.1"
  }
}
